#!/bin/sh
# Check actual staged public content. Private state is validated by state-writing skills.
set -eu
if [ -x .venv/Scripts/python.exe ]; then
    exec .venv/Scripts/python.exe scripts/check_public.py
elif [ -x .venv/bin/python ]; then
    exec .venv/bin/python scripts/check_public.py
elif command -v py >/dev/null 2>&1; then
    exec py -3 scripts/check_public.py
elif command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/check_public.py
else
    echo "Python not found. Create the project environment and install requirements-dev.txt."
    exit 1
fi
